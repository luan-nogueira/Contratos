rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isGestor() {
      return signedIn()
        && hasUserDoc()
        && ("role" in userData())
        && userData().role == "gestor";
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (isOwnUser(uid) || isGestor());
      allow delete: if isGestor();
    }

    match /access_by_email/{email} {
      allow read, get, list: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /contratos/{contractId} {
      allow read, write: if signedIn();

      match /{allPaths=**} {
        allow read, write: if signedIn();
      }
    }
  }
}
