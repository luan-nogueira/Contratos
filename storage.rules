rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // O app não usa o Firebase Storage: fotos e assinaturas são salvas como
    // base64 diretamente no Firestore. Mantido fechado até haver uso real,
    // para não deixar um bucket liberado para qualquer usuário autenticado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
